# Server
PORT=5000
FRONTEND_URL=http://localhost:3000
# In production, set this to your deployed frontend origin, e.g.
# FRONTEND_URL=https://anmolsingh45044-lab.github.io

# Database (MongoDB Atlas free M0 cluster — copy the connection string)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Admin account (used once by `npm run setup`)
ADMIN_USERNAME=anmol
ADMIN_PASSWORD=replace-with-a-strong-password
ALLOW_SETUP=false

# GitHub (used by /api/github — public data, token only raises rate limits)
GITHUB_USERNAME=anmolsingh45044-lab
GITHUB_TOKEN=

# Contact form emails (Gmail app password, not your normal password)
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=anmolsingh45044@gmail.com

# Image uploads (optional — only needed for the admin "upload image" feature)
CLOUDINARY_CLOUD=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
