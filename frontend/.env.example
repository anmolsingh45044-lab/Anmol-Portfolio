# Optional. Leave unset to run the site fully static (GitHub-only): the
# Projects section pulls straight from the public GitHub API and the
# Contact form falls back to opening a pre-filled email.
#
# Set this once you deploy backend/ (e.g. to Render) to enable persisted
# contact messages, the /admin dashboard, and cached GitHub data.
VITE_API_URL=http://localhost:5000/api
